# Configure real values in the NEW app's Hostinger Environment variables screen.
SITE_URL=https://swiftdigitals.au
# Keep false throughout preview. Enable only for a separately authorised cutover.
SITE_INDEXABLE=false
DB_HOST=your_new_database_host
DB_PORT=3306
DB_USER=your_new_database_user
DB_PASSWORD=replace_with_new_database_password
DB_NAME=your_new_database_name
# PORT is assigned by hosting. Leave unset locally for port 3000.
# PORT=3000

# Used by the Hostinger-generated standalone server to bind all interfaces.
HOSTNAME=0.0.0.0
